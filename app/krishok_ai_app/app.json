{
  "expo": {
    "name": "Krishok AI",
    "slug": "krishok-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "krishokai",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.krishokai.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.krishokai.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#EAF1E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Krishok AI to photograph rice leaves.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Krishok AI to select rice leaf photos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F7F1"
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-status-bar",
      "react-native-fast-tflite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "onlineApiBaseUrl": {},
      "offlineModelUri": {},
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "21dfb6d2-174d-443e-af47-666159aa1763"
      }
    }
  }
}
